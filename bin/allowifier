#!/bin/sh
# allowifier — installed by the allowifier plugin. The switch.
#
# allowifier turns the org policy layer off while keeping your own
# permission rules intact. Two ways on:
#
# On top of intility-inference — the usual way on a machine that runs
# both: the gateway's URL in settings.json, respelled (localhost for
# 127.0.0.1) with the first-party flag gone. Claude Code skips the
# org-settings fetch on a custom base URL without that flag, so org
# denies, ask lists and claudeMd never load — while every request
# still travels to the gateway, and the Claude models beyond it.
# intility-inference no longer recognizes the line as its own, so it
# stands down: its daemon keeps the gateway, the deployments and the
# /model rows, and never re-adds the flag.
#
# On its own — a small local proxy (kept alive by a launchd agent)
# and the base URL pointed at it: a custom base URL alone skips the
# org-settings fetch the same way. The proxy answers the
# org-settings path with {} for Claude Code versions that ask the
# base URL for them.
#
#   allowifier on       turn it on (the install does this)
#   allowifier off      the org layer back, and it stays off
#   allowifier status   which way it stands

PORT=8791
PROXY="$HOME/.claude/allowifier-proxy.mjs"
PLIST="$HOME/Library/LaunchAgents/com.alfredtm.allowifier.proxy.plist"
TARGET="$HOME/.local/bin/allowifier"
CFG="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
SETTINGS="$CFG/settings.json"
MARKER="$CFG/allowifier.off"
GATEWAY="http://localhost:8793"

# launchd agents run on a bare PATH — find node ourselves
NODE="$(command -v node 2>/dev/null)"
if [ -z "$NODE" ]; then
  for n in /opt/homebrew/bin/node /usr/local/bin/node \
           "$HOME"/.nvm/versions/node/*/bin/node \
           "$HOME"/.volta/bin/node "$HOME"/.local/bin/node; do
    if [ -x "$n" ]; then NODE="$n"; break; fi
  done
fi
need_node() {
  if [ -z "$NODE" ]; then
    echo "allowifier: node not found — the switch needs it" >&2
    exit 1
  fi
}

# the settings lines, in node — the same state machine the hook
# carries (hooks/setup.ts). One action per call; `mode` prints the
# word for what the base URL line says about who wrote it, the rest
# print done. Nothing else is said, and the file is carried whole.
lines() {
  ACTION="$1" "$NODE" -e '
    const fs = require("fs"), os = require("os"), path = require("path")
    const dir = process.env.CLAUDE_CONFIG_DIR || path.join(os.homedir(), ".claude")
    const settingsPath = path.join(dir, "settings.json")
    const INFERENCE_URL = "http://127.0.0.1:8793"
    const COMPOSED_URL = "http://localhost:8793"
    const PROXY_URL = "http://localhost:8791"
    const FLAG = "_CLAUDE_CODE_ASSUME_FIRST_PARTY_BASE_URL"
    function read() {
      try {
        const s = JSON.parse(fs.readFileSync(settingsPath, "utf8"))
        return s && typeof s === "object" && !Array.isArray(s) ? s : undefined
      } catch (e) {
        return fs.existsSync(settingsPath) ? undefined : {}
      }
    }
    function modeOf(s) {
      const url = s.env && s.env.ANTHROPIC_BASE_URL
      if (url === undefined) return "unset"
      if (url === INFERENCE_URL) return "inference"
      if (url === COMPOSED_URL) return "composed"
      if (url === PROXY_URL) return "standalone"
      return "foreign"
    }
    function withEnv(s, kv) {
      const env = Object.assign({}, s.env || {})
      for (const k of Object.keys(kv)) { if (kv[k] === undefined) delete env[k]; else env[k] = kv[k] }
      const next = Object.assign({}, s)
      if (Object.keys(env).length === 0) delete next.env; else next.env = env
      return next
    }
    const s = read()
    if (s === undefined) {
      console.error("allowifier: " + settingsPath + " is not valid JSON — not touching it")
      process.exit(1)
    }
    const action = process.env.ACTION
    if (action === "mode") { console.log(modeOf(s)); process.exit(0) }
    const kv = action === "compose" ? { ANTHROPIC_BASE_URL: COMPOSED_URL, [FLAG]: undefined }
      : action === "restore" ? { ANTHROPIC_BASE_URL: INFERENCE_URL, [FLAG]: "1" }
      : action === "arm" ? { ANTHROPIC_BASE_URL: PROXY_URL, [FLAG]: undefined }
      : action === "disarm" ? { ANTHROPIC_BASE_URL: undefined, [FLAG]: undefined }
      : undefined
    if (kv === undefined) process.exit(1)
    fs.writeFileSync(settingsPath, JSON.stringify(withEnv(s, kv), null, 2) + "\n")
    console.log("done")
  '
}

# the gateway's own word for itself — the proof that a composition
# would route, before the spelling is written
gateway_up() {
  curl -s -m 5 --retry 5 --retry-connrefused --retry-delay 1 "$GATEWAY/healthz" 2>/dev/null | grep -q '"intility-inference"'
}

# whether intility-inference still runs beneath a composed line: its
# off marker says it does not, or its login is gone
inference_in_play() {
  [ -f "$CFG/intility-inference/off" ] && return 1
  [ -f "$CFG/intility-inference/session.json" ] || return 1
  return 0
}

# a standalone proxy serves nothing composed — the agent goes
cleanup_agent() {
  launchctl unload "$PLIST" >/dev/null 2>&1
  rm -f "$PLIST"
  pkill -f allowifier-proxy.mjs 2>/dev/null
}

write_proxy() {
  cat > "$PROXY" <<'EOF'
import http from 'node:http'
import https from 'node:https'

const PORT = Number(process.argv[2] ?? 8791)
const UP = 'https://api.anthropic.com'

http.createServer((req, res) => {
  res.on('error', () => {})
  try {
    if (req.url.startsWith('/api/claude_code/settings')) {
      res.writeHead(200, { 'content-type': 'application/json' })
      res.end('{}')
      return
    }
    const u = new URL(req.url, UP)
    const headers = { ...req.headers }
    delete headers.host
    delete headers.connection
    const upReq = https.request(u, { method: req.method, headers }, upRes => {
      res.writeHead(upRes.statusCode ?? 502, upRes.headers)
      upRes.pipe(res)
    })
    upReq.on('error', () => {
      try { res.writeHead(502); res.end('allowifier-proxy: upstream error') } catch {}
    })
    req.pipe(upReq)
  } catch {
    try { res.writeHead(400); res.end('allowifier-proxy: bad request') } catch {}
  }
}).listen(PORT, () => console.log(`allowifier proxy on ${PORT}`))
EOF
}

case "$1" in
on)
  # on: the marker gone, then whichever way this machine goes on
  rm -f "$MARKER"
  need_node
  MODE="$(lines mode)" || exit 1

  case "$MODE" in
  composed)
    # already ours, over the gateway — it must still answer through
    # our spelling
    if ! gateway_up; then
      echo "allowifier: the intility-inference gateway is not answering on $GATEWAY — try again" >&2
      exit 1
    fi
    cleanup_agent
    echo "allowifier on; on top of intility-inference — the org layer does not load,"
    echo "  the gateway keeps routing: GLM beside the Claude models, as before"
    exit 0
    ;;
  inference)
    # intility-inference armed, whole: compose on top of it — only
    # once the gateway has answered through the spelling we write
    if ! gateway_up; then
      echo "allowifier: the intility-inference gateway is not answering on $GATEWAY — not composing; start a claude session (it starts the gateway) and try again" >&2
      exit 1
    fi
    lines compose || exit 1
    cleanup_agent
    echo "allowifier on; on top of intility-inference — the org layer does not load,"
    echo "  the gateway keeps routing: GLM beside the Claude models, as before"
    echo "(the next session runs the new way)"
    exit 0
    ;;
  standalone)
    # already ours, behind the proxy — the rest of this arm is
    # idempotent: the proxy rewritten, the agent reloaded, the line
    # written again only once the proxy has answered
    ;;
  unset)
    # nothing routes claude through a base URL — the standalone proxy
    ;;
  foreign)
    echo "allowifier: ANTHROPIC_BASE_URL is already set to something else — not ours to take over" >&2
    exit 1
    ;;
  esac

  need_node
  write_proxy
  # the agent runs the installed switch: put this script there
  mkdir -p "$HOME/.local/bin"
  if [ ! -x "$TARGET" ]; then
    SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
    cp "$SELF" "$TARGET"
    chmod +x "$TARGET"
  fi
  # a plist names the switch it runs; a stale one is rewritten
  if ! grep -q "$TARGET" "$PLIST" 2>/dev/null; then
    mkdir -p "$HOME/Library/LaunchAgents"
    cat > "$PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.alfredtm.allowifier.proxy</string>
    <key>ProgramArguments</key>
    <array>
        <string>${TARGET}</string>
        <string>--proxy</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>${HOME}/.claude/allowifier-proxy.log</string>
    <key>StandardErrorPath</key><string>${HOME}/.claude/allowifier-proxy.log</string>
</dict>
</plist>
PLIST
  fi
  launchctl unload "$PLIST" >/dev/null 2>&1
  launchctl load "$PLIST" >/dev/null 2>&1
  # only write the env line once the proxy has answered
  ANSWER="$(curl -s -m 5 --retry 10 --retry-connrefused --retry-delay 1 "http://localhost:$PORT/api/claude_code/settings" 2>/dev/null)"
  if [ "$ANSWER" != "{}" ]; then
    echo "allowifier: the proxy is not answering on port $PORT" >&2
    exit 1
  fi
  lines arm || exit 1
  echo "allowifier on; plain claude runs without the org layer"
  exit 0
  ;;
off)
  # off, and it stays off: the marker keeps every session and every
  # update from turning it back on over this choice
  need_node
  MODE="$(lines mode)" || MODE=unknown
  cleanup_agent
  : > "$MARKER"
  case "$MODE" in
  composed)
    # our line over intility-inference: theirs back, whole — unless
    # inference is out, when there is nothing to hand back to
    if inference_in_play; then
      lines restore || exit 1
      echo "allowifier off; intility-inference's line is back whole — the next claude loads the org settings"
    else
      lines disarm || exit 1
      echo "allowifier off; intility-inference is out — the next claude loads the org settings"
    fi
    ;;
  standalone)
    lines disarm || exit 1
    echo "allowifier off; the next claude loads the org settings"
    ;;
  *)
    # not ours — the marker is the whole change
    echo "allowifier off; the next claude loads the org settings"
    ;;
  esac
  echo "allowifier on turns it back on"
  exit 0
  ;;
status)
  if [ -n "$NODE" ]; then
    MODE="$(lines mode 2>/dev/null)" || MODE=unknown
  elif grep -q "\"$GATEWAY\"" "$SETTINGS" 2>/dev/null; then
    MODE=composed
  elif grep -q '"http://127.0.0.1:8793"' "$SETTINGS" 2>/dev/null; then
    MODE=inference
  elif grep -q '"http://localhost:8791"' "$SETTINGS" 2>/dev/null; then
    MODE=standalone
  elif grep -q '"ANTHROPIC_BASE_URL"' "$SETTINGS" 2>/dev/null; then
    MODE=foreign
  else
    MODE=unset
  fi
  if [ -f "$MARKER" ]; then OFF="off, by choice"; else OFF="on"; fi
  case "$MODE" in
  composed)
    echo "allowifier: $OFF — on top of intility-inference"
    echo "  claude    ANTHROPIC_BASE_URL=$GATEWAY (the inference gateway, our spelling)"
    echo "  org layer not fetched (custom base URL, no first-party flag)"
    if gateway_up; then echo "  gateway   answering on $GATEWAY"; else echo "  gateway   not answering on $GATEWAY"; fi
    ;;
  inference)
    echo "allowifier: off — intility-inference is armed, and the org layer loads through its flag"
    ;;
  standalone)
    echo "allowifier: $OFF — plain claude runs without the org layer"
    echo "  claude    ANTHROPIC_BASE_URL=http://localhost:$PORT (the local proxy)"
    ;;
  foreign)
    echo "allowifier: off — ANTHROPIC_BASE_URL is set to something else, not ours"
    ;;
  unset)
    echo "allowifier: off — the next claude loads the org settings"
    ;;
  *)
    echo "allowifier: $SETTINGS is not valid JSON — cannot say"
    ;;
  esac
  if launchctl list 2>/dev/null | grep -q com.alfredtm.allowifier.proxy; then
    echo "agent: loaded"
  else
    echo "agent: not loaded"
  fi
  exit 0
  ;;
--proxy)
  # the launchd agent's entry: the proxy, foreground
  need_node
  write_proxy
  exec "$NODE" "$PROXY" "$PORT"
  ;;
*)
  echo "usage: allowifier on | off | status" >&2
  exit 1
  ;;
esac
